{
  "name": "dsh-fish-boot",
  "displayName": "DSH 开机动画（大肥鱼）",
  "version": "0.1.7",
  "description": "A configurable full-screen video startup animation for DeepSeek Harness, with its own settings section.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "boot-animation",
    "splash",
    "startup"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.1.7-rc.1 || 0.2.0-rc.1 || 0.2.0-rc.2",
    "react": "^18.2.0"
  }
}
